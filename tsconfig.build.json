{
  // Build config: emit only the shipped sources to dist/. Test files are still
  // type-checked (via tsconfig.json + `npm run typecheck`) but never emitted.
  "extends": "./tsconfig.json",
  // TypeScript 6 requires this to be stated rather than inferred from the input
  // set. The value is the one 5.x already inferred, so the emitted layout does
  // not move — this is about saying it out loud.
  "compilerOptions": { "rootDir": "./src" },
  "include": ["src/**/*"],
  "exclude": ["test/**/*"]
}
